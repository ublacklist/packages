{
  "name": "@ublacklist/packages",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm run /^check:/",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "fix": "pnpm run /^fix:/",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "lefthook": "2.2.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
